      "cell_type": "markdown",
      "id": "757f0d65",
      "metadata": {
        "id": "757f0d65"
      },
      "source": [
        "## Data (same as Lab 3.1)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "7defccc8",
      "metadata": {
        "id": "7defccc8",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "c5577bba-0b92-4818-feb8-e06e578a8c8c"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "1771 documents in ['sci.space', 'comp.graphics', 'sci.med']\n"
          ]
        }
      ],
      "source": [
        "def local_file(name, lab=\"lab3\"):\n",
        "    path = os.path.join(\"data\", name)\n",
        "    if not os.path.exists(path):\n",
        "        os.makedirs(\"data\", exist_ok=True)\n",
        "        urllib.request.urlretrieve(f\"https://raw.githubusercontent.com/ababacaryoro/nlp-course/main/{lab}/data/{name}\", path)\n",
        "    return path\n",
        "\n",
        "try:\n",
        "    df = pd.read_json(\"hf://datasets/SetFit/20_newsgroups/train.jsonl\", lines=True)\n",
        "except Exception as e:\n",
        "    print(f\"Hugging Face unavailable ({type(e).__name__}), using the local copy\")\n",
        "    df = pd.read_csv(local_file(\"20_newsgroups_train.csv.gz\"))\n",
        "df = df.dropna(subset=[\"text\"]).reset_index(drop=True)\n",
        "\n",
        "# Filled in with 3 valid 20 Newsgroups categories\n",
        "my_categories = [\"sci.space\", \"comp.graphics\", \"sci.med\"]\n",
        "assert len(set(my_categories)) == 3 and all(c in df[\"label_text\"].unique() for c in my_categories), \"Use 3 valid categories\"\n",
        "\n",
        "df_filtered = df[df[\"label_text\"].isin(my_categories)].reset_index(drop=True)\n",
        "print(f\"{len(df_filtered)} documents in {my_categories}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "030e39a7",
      "metadata": {
        "id": "030e39a7",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "c910792e-0ae9-4467-e712-598c44e0d59b"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Corpus: 1771 documents, 178594 tokens\n",
            "['weitek', 'address', 'phone', 'number', 'like', 'get', 'information', 'chip']\n"
          ]
        }
      ],
      "source": [
        "stop_words = set(stopwords.words(\"english\"))\n",
        "lemmatizer = WordNetLemmatizer()\n",
        "\n",
        "def preprocess_tokens(text):\n",
        "    \"\"\"Same cleaning as Lab 3.1, returning a list of tokens (Word2Vec expects tokenized sentences).\"\"\"\n",
        "    text = str(text).lower()\n",
        "    text = re.sub(r\"\\S+@\\S+\", \" \", text)\n",
        "    text = re.sub(r\"https?://\\S+|www\\.\\S+\", \" \", text)\n",
        "    text = re.sub(r\"[^a-z\\s]\", \" \", text)\n",
        "    tokens = [lemmatizer.lemmatize(t) for t in text.split() if t not in stop_words and len(t) >= 3]\n",
        "    return tokens\n",
        "\n",
        "df_filtered[\"tokens\"] = df_filtered[\"text\"].apply(preprocess_tokens)\n",
        "df_filtered[\"text_clean\"] = df_filtered[\"tokens\"].apply(\" \".join)\n",
        "corpus = df_filtered[\"tokens\"].tolist()\n",
        "print(f\"Corpus: {len(corpus)} documents, {sum(len(d) for d in corpus)} tokens\")\n",
        "print(corpus[0][:15])"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "905f8d82",
      "metadata": {
        "id": "905f8d82"
      },
      "source": [
        "---\n",
        "# Part A – Word2Vec: train your own embeddings\n",
        "\n",
        "Word2Vec learns a vector per word by predicting words from their context:\n",
        "- **CBOW** predicts the target word from its context words,\n",
        "- **Skip-gram** predicts the context words from the target word."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "c9786b66",
      "metadata": {
        "id": "c9786b66",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "4689f2a2-41e0-4fca-a3e6-3c0ee7d0110a"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Vocabulary size: 5241 words\n"
          ]
        }
      ],
      "source": [
        "common = dict(sentences=corpus, vector_size=100, window=5, min_count=5, workers=4, epochs=10, seed=42)\n",
        "model_cbow = Word2Vec(sg=0, **common)\n",
        "model_skipgram = Word2Vec(sg=1, **common)\n",
        "print(f\"Vocabulary size: {len(model_cbow.wv)} words\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "e190af05",
      "metadata": {
        "id": "e190af05",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "45ac2983-ea78-4b02-af13-17108da13c92"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Vector of 'game': shape (100,), first values [ 0.17047963 -0.16638783 -0.17383386  0.16838144 -0.18271723]\n",
            "\n",
            "Most similar (CBOW):      ['fundamental', 'overhead', 'style', 'framework', 'personal', 'searching', 'fancy', 'upgrade']\n",
            "Most similar (Skip-gram): ['gnuplot', 'appearing', 'multiverse', 'finished', 'netnews', 'undocumented', 'newest', 'fake']\n"
          ]
        }
      ],
      "source": [
        "word = \"game\"   # change to a word of your domain\n",
        "if word in model_cbow.wv:\n",
        "    print(f\"Vector of '{word}': shape {model_cbow.wv[word].shape}, first values {model_cbow.wv[word][:5]}\")\n",
        "    print(\"\\nMost similar (CBOW):     \", [w for w, s in model_cbow.wv.most_similar(word, topn=8)])\n",
        "    print(\"Most similar (Skip-gram):\", [w for w, s in model_skipgram.wv.most_similar(word, topn=8)])\n",
        "else:\n",
        "    print(f\"'{word}' is not in the vocabulary. Examples:\", list(model_cbow.wv.key_to_index)[:20])"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "b51cac6b",
      "metadata": {
        "id": "b51cac6b"
      },
      "source": [
