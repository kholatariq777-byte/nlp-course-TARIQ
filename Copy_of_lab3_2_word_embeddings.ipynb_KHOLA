      "source": [
        "### Exercise C.1 – Document similarity with sentence embeddings\n",
        "\n",
        "Encode 30 documents (10 per category, first 500 characters) and compute their cosine similarity matrix."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 14,
      "id": "1d5994ee",
      "metadata": {
        "id": "1d5994ee",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 648
        },
        "outputId": "9267d6ea-e7fe-47c9-dbe1-98345bbdfe92"
      },
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1000x800 with 2 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ],
      "source": [
        "# Sample 10 documents per category\n",
        "df_sampled = pd.concat([df_filtered[df_filtered[\"label_text\"] == cat].head(10) for cat in my_categories]).reset_index(drop=True)\n",
        "\n",
        "sampled_docs = df_sampled[\"text\"].str[:500].tolist()\n",
        "sampled_labels = df_sampled[\"label_text\"].tolist()\n",
        "\n",
        "# Encode documents with the SentenceTransformer\n",
        "doc_embeddings = sentence_model.encode(sampled_docs)\n",
        "\n",
        "# Compute cosine similarity matrix\n",
        "bert_similarity = cosine_similarity(doc_embeddings)\n",
        "\n",
        "# Assert shapes to verify\n",
        "assert doc_embeddings.shape == (30, 384), f\"Expected (30, 384), got {doc_embeddings.shape}\"\n",
        "assert bert_similarity.shape == (30, 30), f\"Expected (30, 30), got {bert_similarity.shape}\"\n",
        "\n",
        "# Plot similarity heatmap\n",
        "plt.figure(figsize=(10, 8))\n",
        "sns.heatmap(bert_similarity, xticklabels=sampled_labels, yticklabels=sampled_labels, cmap=\"viridis\", vmin=0, vmax=1)\n",
        "plt.title(\"Semantic Similarity Matrix (Sentence-BERT)\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
